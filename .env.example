# 이 파일을 .env로 복사한 뒤 값을 채우세요 (자세한 발급 방법은 SETUP.md 참고)

# https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=

# 텔레그램에서 @BotFather에게 /newbot 실행해서 발급
TELEGRAM_BOT_TOKEN=

# 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 접속해서 chat.id 확인
TELEGRAM_CHAT_ID=

# 기존 post.py에서 쓰던 블로그 ID (기본값)
BLOGGER_BLOG_ID=6119363643599838869
# 연락처 페이지(setup_pages.py)에 표시할 이메일 (선택, 비워두면 빈 채로 올라감)
BLOG_CONTACT_EMAIL=
